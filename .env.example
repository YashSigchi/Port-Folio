# ============================================================================
# 1. EMAIL CONFIGURATION (Render Free Tier Compatible)
# ============================================================================
# Render's free tier blocks outbound SMTP ports (25, 465, 587).
# Use an HTTPS REST API provider ("brevo" or "emailjs") for Render deployment:
#
# - "brevo"   (RECOMMENDED for Render Free Tier — 300 emails/day free, sends to
#              BOTH you and the visitor's auto-reply address using your verified
#              Gmail address at app.brevo.com, no custom domain needed!)
# - "emailjs" (HTTPS API — 200 emails/month free via dashboard.emailjs.com)
# - "resend"  (HTTPS API — requires a custom domain to send auto-replies to visitors)
# - "smtp"    (Nodemailer Gmail App Password — works on localhost & Vercel)
MAIL_PROVIDER=brevo

# Recipient & Sender Identity
OWNER_EMAIL=yash.sigchi08@gmail.com
FROM_NAME="Yash Sigchi"

# --- Option A: Brevo HTTPS API (Recommended for Render Free Tier) ---
# 1. Sign up free at https://app.brevo.com
# 2. Go to Senders, Domains & Dedicated IPs → Senders → Verify yash.sigchi08@gmail.com
# 3. Go to SMTP & API → API Keys → Generate a new API key (starts with xkeysib-...)
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BREVO_SENDER_EMAIL=yash.sigchi08@gmail.com

# --- Option B: EmailJS HTTPS API (Alternative for Render Free Tier) ---
# 1. Sign up free at https://dashboard.emailjs.com & connect your Gmail service
# 2. Create a template with: To Email = {{to_email}}, Reply To = {{reply_to}},
#    Subject = {{subject}}, Content = {{{html_body}}}
# 3. Enable Account → Security → "Allow EmailJS API for non-browser applications"
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# --- Option C: Resend HTTPS API ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Option D: SMTP (Localhost / Vercel) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yash.sigchi08@gmail.com
SMTP_PASS=

# ============================================================================
# 2. FREE CHATBOT AI CONFIGURATION ("Ask Yash")
# ============================================================================
# Auto-detects whichever key you provide below (or set CHAT_PROVIDER explicitly
# to "groq", "gemini", "openrouter", or "anthropic"):
CHAT_PROVIDER=groq

# --- Option A: Groq Free API Key (RECOMMENDED — 100% Free, Ultra-Fast, No Card) ---
# Get a free key at: https://console.groq.com/keys
# Default model when using Groq: llama-3.3-70b-versatile
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Option B: Google Gemini Free API Key (100% Free via Google AI Studio) ---
# Get a free key at: https://aistudio.google.com/app/apikey
# Default model when using Gemini: gemini-2.0-flash
GEMINI_API_KEY=

# --- Option C: OpenRouter Free Models ---
# Get a key at: https://openrouter.ai/keys
# Default model when using OpenRouter: meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_API_KEY=

# --- Option D: Anthropic (Optional Fallback) ---
ANTHROPIC_API_KEY=

# Optional model override (leave blank to use the provider's default model)
CHAT_MODEL=

# ============================================================================
# 3. OPTIONAL UPSTASH REDIS (Falls back to in-memory Map if left blank)
# ============================================================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
